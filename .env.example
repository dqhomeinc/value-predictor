# app.py falls back to a hardcoded dev-only value if this is unset locally.
# Always set a real value in production (render.yaml auto-generates one on Render).
SECRET_KEY=
DATABASE_URL=

# Used starting Phase 2 (RentCast integration)
RENTCAST_API_KEY=

# Serves synthetic, made-up property data instead of spending real RentCast
# calls (free tier is ~50/month) — see integrations/rentcast_mock.py. ON BY
# DEFAULT locally (whenever DATABASE_URL is unset) — leave this blank for
# normal local dev. Set to 0 to opt out and use real RentCast data locally
# (e.g. to verify before a PR). Setting it to 1 is only ever needed to force
# it on explicitly; either way, it's refused outright if DATABASE_URL is
# also set (i.e. a deployed environment) — never set this in production.
RENTCAST_MOCK=
