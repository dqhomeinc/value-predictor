# app.py falls back to a hardcoded dev-only value if this is unset locally.
# Always set a real value in production (render.yaml auto-generates one on Render).
SECRET_KEY=
DATABASE_URL=

# Used starting Phase 2 (RentCast integration)
RENTCAST_API_KEY=

# Set to 1 for local dev/manual testing to serve synthetic, made-up property
# data instead of spending real RentCast calls (free tier is ~50/month) —
# see integrations/rentcast_mock.py. Works without RENTCAST_API_KEY set.
# Refuses to activate if DATABASE_URL is also set (i.e. a deployed
# environment) — never set this in production.
RENTCAST_MOCK=
